model UserLevel {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  xp        Int      @default(0)
  level     Int      @default(0)
  lastXpAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([guildId, userId])
  @@index([guildId, xp])
}
