model Warning {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  moderatorId String
  reason    String
  createdAt DateTime @default(now())
  @@index([guildId, userId])
}

model AutoModConfig {
  id              String   @id @default(cuid())
  guildId         String   @unique
  enabled          Boolean  @default(false)
  antiInvite       Boolean  @default(true)
  antiLinks       Boolean  @default(false)
  bannedWords      String   @default("")
  logChannelId     String?
  updatedAt        DateTime @updatedAt
}

model WelcomeConfig {
  id          String   @id @default(cuid())
  guildId     String   @unique
  enabled     Boolean  @default(false)
  channelId   String?
  message     String   @default("Welcome {user} to {server}!")
}
