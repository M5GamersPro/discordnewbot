model ReactionRole {
  id        String   @id @default(cuid())
  guildId   String
  channelId String
  messageId String
  emoji     String
  roleId    String
  createdAt DateTime @default(now())
  @@unique([guildId, messageId, emoji])
}

model VerificationConfig {
  id        String   @id @default(cuid())
  guildId   String   @unique
  channelId String
  messageId String
  roleId    String
}

model Giveaway {
  id        String   @id @default(cuid())
  guildId   String
  channelId String
  messageId String
  prize     String
  winners   Int
  endsAt    DateTime
  createdAt DateTime @default(now())
}

model LogChannel {
  id        String   @id @default(cuid())
  guildId   String   @unique
  channelId String
}
